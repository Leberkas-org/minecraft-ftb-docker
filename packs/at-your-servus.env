# At your Servus
# https://www.curseforge.com/minecraft/modpacks/at-your-servus
#
# Minecraft 26.1.2  neoforge 26.1.2.122 (so Java 25)
# 108 server-side mods
PACK_PROVIDER=curseforge
PACK_ID=1754779
PACK_VERSION=9260316
IMAGE=ghcr.io/leberkas-org/minecraft_at_your_servus
TAG=0.1.0-alpha
MEMORY=6G
#
# The pack has only published alpha builds so far; track them until a release
# ships, then drop this line.
INCLUDE_PRERELEASE=true
#
# EXCLUDE_MODS takes space-separated globs, for mods the manifest wrongly
# marks as server-side. Add them if the first build will not boot.
