# All the Mods 10
# https://www.curseforge.com/minecraft/modpacks/all-the-mods-10
#
# PACK_ID      = CurseForge project id
# PACK_VERSION = CurseForge file id (see `build.ps1 -Latest` to resolve it)
PACK_PROVIDER=curseforge
PACK_ID=925200
PACK_VERSION=8558519
IMAGE=dirnei/minecraft_atm_10
TAG=7.3
MEMORY=10G
# JAVA_VERSION is derived from the pack's Minecraft version; set it here only
# to override (this pack is 1.21.1, so Java 21).
#
# colorwheel is not flagged clientonly in the manifest but hard-requires iris,
# which is. Left in, NeoForge refuses to start the server with
# "Mod colorwheel requires iris 1.8.0 or above / Currently, iris is not installed".
EXCLUDE_MODS=colorwheel*
